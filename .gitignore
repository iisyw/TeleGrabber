# 本地实际配置（含敏感信息）
conf/config.toml

# Python虚拟环境
venv/
env/
__pycache__/
*.py[cod]
*$py.class

# 图片保存目录
downloads/

# 日志文件
*.log

# 临时文件
*.tmp
.DS_Store

# Pyrogram 会话文件 (包含敏感登录凭据，切勿上传)
*.session
*.session-journal

# SQLite 数据库
*.db
*.db-shm
*.db-wal

# 审计日志
data/audit*.json

# 缩略图（可重建的派生缓存）
data/thumbs/

# 前端依赖与构建产物
web/node_modules/
web/dist/