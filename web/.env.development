# 开发环境配置
NODE_ENV=development
VITE_PORT=5173
VITE_OPEN=true
VITE_USE_HTTPS=false

# 后端服务地址，开发环境 Vite 会将 /api、/media、/thumb 代理到该地址
# 后端端口在 conf/config.toml 的 [web].port 中维护，修改后同步这里
VITE_API_PROXY_URL=127.0.0.1:5005

# 构建配置
VITE_DROP_CONSOLE=false
VITE_DROP_DEBUGGER=false

# SSL 证书配置，仅 VITE_USE_HTTPS=true 时有效
VITE_SSL_KEY_PATH=./ssl/cert-key.pem
VITE_SSL_CERT_PATH=./ssl/cert.pem
